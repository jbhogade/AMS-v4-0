# Copy to .env next to manage.py and fill in real values.
# Values already present in the process environment win over this file.

# --- Core Django -------------------------------------------------------------
# Required when AMS_DEBUG=0. Generate with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
AMS_DJANGO_SECRET_KEY=your-long-random-secret-key-here
AMS_DEBUG=1
# Comma-separated hosts. Leave unset for "*" in dev; set real hosts in production.
AMS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- SQL Server --------------------------------------------------------------
AMS_DB_SERVER=localhost
AMS_DB_NAME=AMS-v4-0
# Leave AMS_DB_USER empty to use Windows/Trusted authentication.
AMS_DB_USER=
AMS_DB_PASSWORD=
AMS_DB_DRIVER=ODBC Driver 18 for SQL Server
AMS_DB_TRUST_CERT=yes
AMS_DB_CONNECT_TIMEOUT=15

# --- JWT (must match the .NET API so tokens are interchangeable) -------------
# Required when AMS_DEBUG=0. Use a long random value, kept out of version control.
AMS_JWT_KEY=your-long-random-jwt-signing-key-here
AMS_JWT_ISSUER=AMS-API
AMS_JWT_AUDIENCE=AMS-App
AMS_JWT_EXPIRY_MINUTES=480

# --- Seeded login accounts (override the built-in dev passwords) -------------
AMS_SEED_OPERATOR_PASSWORD=change-this-seed-operator-password
AMS_SEED_ADMIN_PASSWORD=change-this-seed-admin-password
